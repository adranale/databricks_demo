{
  "datasets": [
    {
      "name": "product_metrics",
      "displayName": "Product Performance (Gold)",
      "config": {
        "version": "1.1",
        "source": "ops.gold.product_performance",
        "dimensions": [
          {
            "name": "Product ID",
            "expr": "product_id"
          },
          {
            "name": "Product Name",
            "expr": "product_name"
          },
          {
            "name": "Category",
            "expr": "product_category"
          },
          {
            "name": "Brand",
            "expr": "brand"
          },
          {
            "name": "Status",
            "expr": "product_status"
          },
          {
            "name": "Performance",
            "expr": "sales_performance"
          }
        ],
        "measures": [
          {
            "name": "Revenue",
            "expr": "SUM(realized_revenue_usd)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "Units Sold",
            "expr": "SUM(units_sold)"
          },
          {
            "name": "Orders",
            "expr": "SUM(orders_count)"
          },
          {
            "name": "Products",
            "expr": "COUNT(product_id)"
          },
          {
            "name": "Avg List Price",
            "expr": "AVG(list_price_usd)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "document_metrics",
      "displayName": "Document Intelligence (Gold)",
      "config": {
        "version": "1.1",
        "source": "ops.gold.document_intelligence_summary",
        "dimensions": [
          {
            "name": "Document",
            "expr": "source_file"
          },
          {
            "name": "Doc Type",
            "expr": "doc_type"
          }
        ],
        "measures": [
          {
            "name": "Documents",
            "expr": "COUNT(source_file)"
          },
          {
            "name": "Extracted Text",
            "expr": "SUM(extracted_text_chars)"
          },
          {
            "name": "Elements",
            "expr": "SUM(element_count)"
          },
          {
            "name": "Pages",
            "expr": "SUM(page_count)"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "product_ai_page",
      "displayName": "Product & Document Intelligence",
      "layout": [
        {
          "widget": {
            "name": "counter_total_revenue",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "product_metrics",
                  "fields": [
                    {
                      "name": "revenue",
                      "expression": "MEASURE(`Revenue`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": {
                "title": "Total Realized Revenue",
                "showTitle": true
              },
              "encodings": {
                "value": {
                  "fieldName": "revenue",
                  "displayName": "Revenue",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                }
              },
              "data": {
                "queryName": "main"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "counter_products",
            "queries": [
              {
                "name": "main",
                "query": {
